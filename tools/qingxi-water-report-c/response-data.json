      "inspect_crack": "槽邊是否破損還待確認，可以先請工匠檢查舊水路。",
      "protect_nursery": "上游斷流，村裡水少，可以先留意溪畔幼獸與育幼區。"
    },
    "pending": {
      "tell_shortage": "上游已有缺水跡象，水還沒導回來，可以先把看到的情況告知大家。",
      "inspect_crack": "水還沒導回來，槽邊狀況需要確認，可以先把線索交給工匠。",
      "protect_nursery": "水還沒導回來，溪畔幼獸也需要留意，可以先保護育幼區。"
    },
    "partial": {
      "tell_shortage": "水只部分恢復，先把你看到的缺水記下來，別急著說修好。",
      "inspect_crack": "水只部分恢復，可以請工匠檢查舊槽，看看哪段仍在漏水。",
      "protect_nursery": "水只部分恢復，溪畔幼獸仍可能受影響，可以先保護育幼區。"
    },
    "restored": {
      "tell_shortage": "水已恢復，先把你看到的先前缺水記下來，讓後人知道。",
      "inspect_crack": "水已恢復，可以請工匠看看舊槽，確認槽邊還穩不穩。",
      "protect_nursery": "水已恢復，溪畔幼獸也可能回來，可以繼續留意育幼區。"
    },
    "protected": {
      "tell_shortage": "育幼區已保護，村田仍部分供水，先把你看到的缺水記下來。",
      "inspect_crack": "育幼區已保護，村田仍部分供水，可以先請工匠檢查舊槽。",
      "protect_nursery": "育幼區已保護，村田仍部分供水，接下來也能再看看村田的需要。"
    }
  },
  "testCases": [
    {
      "name": "無線索仍可回報",
      "input": {
        "observationIds": [],
        "outcomeId": null
      },
      "actions": [
        "select:tell_shortage"
      ],
      "expectedState": "none",
      "expectedChoice": "tell_shortage"
    },
    {
      "name": "未知結果不變成完成",
      "input": {
        "observationIds": [
          "cracked_sluice"
        ],
        "outcomeId": "unknown_repair"
      },
      "actions": [
        "select:inspect_crack"
      ],
      "expectedState": "unknown",
      "expectedChoice": "inspect_crack"
    },
    {
      "name": "重複點不重複記錄",
      "input": {
        "observationIds": [
          "cracked_sluice"
        ],
        "outcomeId": null
      },
      "actions": [
        "select:tell_shortage",
        "select:tell_shortage"
      ],
      "expectedState": "pending",
      "expectedChoice": "tell_shortage",
      "expectedEvents": 1
    },
    {
      "name": "改選不更改上游結果",
      "input": {
        "observationIds": [
          "silt_buildup"
        ],
        "outcomeId": "clear_silt"
      },
      "actions": [
        "select:inspect_crack",
        "select:protect_nursery"
      ],
      "expectedState": "partial",
      "expectedChoice": "protect_nursery"
    },
    {
      "name": "取消返回未選",
      "input": {
        "observationIds": [
          "nursery_tracks"
        ],
        "outcomeId": null
      },
      "actions": [
        "select:protect_nursery",
        "cancel:protect_nursery"
      ],
      "expectedState": "pending",
      "expectedChoice": null
    },
    {
      "name": "部分恢復不等同完成",
      "input": {
        "observationIds": [
          "cracked_sluice",
          "silt_buildup"
        ],
        "outcomeId": "clear_silt"
      },
      "actions": [
        "select:tell_shortage"
      ],
      "expectedState": "partial",
      "expectedChoice": "tell_shortage"
    },
    {
      "name": "完整恢復與部分恢復不同",
      "input": {
        "observationIds": [
          "cracked_sluice",
          "silt_buildup"
        ],
        "outcomeId": "restore_channel"
      },
      "actions": [
        "select:tell_shortage"
      ],
      "expectedState": "restored",
      "expectedChoice": "tell_shortage"
    },
    {
      "name": "保護育幼區仍部分供水",
      "input": {
        "observationIds": [
          "nursery_tracks"
        ],
        "outcomeId": "protect_nursery"
      },
      "actions": [
        "select:protect_nursery"
      ],
      "expectedState": "protected",
      "expectedChoice": "protect_nursery"
    }
  ]
}
